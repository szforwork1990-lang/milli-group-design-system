{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/decision-deck/**",
              "components/layouts/**",
              "components/slide-chrome/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Yekan Bakh VF|Yekan Bakh VF Black|B Yekan))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Yekan Bakh VF, Yekan Bakh VF Black, B Yekan."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|color|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|active|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<ChapterDots> doesn't accept that prop. Declared props: total, active, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterDots'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ChapterDots> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterOpener'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|abstract|contentsLabel|contents|dir|style|key|ref|className|style|children)$/]",
        "message": "<ChapterOpener> doesn't accept that prop. Declared props: number, title, abstract, contentsLabel, contents, dir, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterOpener'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:rtl|ltr)$/]",
        "message": "<ChapterOpener> dir must be one of 'rtl' | 'ltr'."
